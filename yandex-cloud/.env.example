# Скопируйте в yandex-cloud/.env и заполните

# FQDN брокеров через запятую, порт 9091 (SASL_SSL). Список: yc managed-kafka cluster list-hosts kafka-practice
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC_NAME=practice-topic
SCHEMA_REGISTRY_URL=http://localhost:8081

# Параметры кластера для create-cluster.sh
CLUSTER_NAME=kafka-practice
NETWORK_NAME=default

# Пароль truststore с сертификатом Yandex Cloud (create-truststore.sh)
CERT_PASSWORD=

# Пользователи кластера (создаются create-cluster.sh)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PRODUCER_USERNAME=producer
PRODUCER_PASSWORD=
CONSUMER_USERNAME=consumer
CONSUMER_PASSWORD=
SCHEMA_REGISTRY_USERNAME=schema-registry
SCHEMA_REGISTRY_PASSWORD=
